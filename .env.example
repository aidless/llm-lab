# llm-lab — 环境变量示例（复制为 .env 并填写）

# ---- LLM 后端 ----
LLM_PROVIDER=
LLM_MODEL=
LLM_API_KEY=
LLM_BASE_URL=
LLM_LAB_DB_PATH=
